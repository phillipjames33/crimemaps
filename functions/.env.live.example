# Verified Free Public Municipal Open-Data Crime Feeds & OSM ALPR Camera Sync
# Copy values into functions/.env.<project-id> (gitignored) and deploy functions
# when switching Cloud Functions ingestion from seeded mock mode to live feeds.

USE_MOCK_DATA=false

# Verified HTTP 200 public Socrata municipal crime feeds (Chicago PD + San Francisco PD)
CRIME_FEED_SOURCES=[{"type":"socrata","id":"chicago_pd_socrata","domain":"data.cityofchicago.org","datasetId":"ijzp-q8t2","cityName":"Chicago","stateCode":"IL","sourceAgency":"Chicago Police Department Open Data","limit":200,"fieldMap":{"id":"id","title":"primary_type","description":"description","address":"block","occurredAt":"date","latitude":"latitude","longitude":"longitude"}},{"type":"socrata","id":"sfpd_socrata","domain":"data.sfgov.org","datasetId":"wg3w-h783","cityName":"San Francisco","stateCode":"CA","sourceAgency":"San Francisco Police Department Open Data","limit":200,"fieldMap":{"id":"incident_id","title":"incident_category","description":"incident_description","address":"intersection","occurredAt":"incident_datetime","latitude":"latitude","longitude":"longitude"}}]

# Public OpenStreetMap Overpass ALPR / Traffic / Red-Light Civic Camera sync (Atlanta Metro)
CAMERA_FEED_SOURCES=[{"type":"osm","id":"osm_atlanta_metro","bbox":{"citySlug":"atlanta","stateCode":"GA","south":33.65,"west":-84.50,"north":33.90,"east":-84.25}}]
