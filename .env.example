# Crime Maps Environment Configuration (Copy to .env and never commit real secrets)
# Pass Flutter values via: flutter run --dart-define-from-file=.env

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_MAP_ID=your_google_maps_cloud_map_id_here
SPOTCRIME_API_KEY=your_spotcrime_api_key_here
BOOKING_API_KEY=your_county_jail_booking_api_key_here
REVENUECAT_IOS_KEY=your_revenuecat_ios_public_sdk_key_here
REVENUECAT_ANDROID_KEY=your_revenuecat_android_public_sdk_key_here
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_UNIT_ID=ca-app-pub-3940256099942544/6300978111
USE_MOCK_DATA=true
USE_FIREBASE_EMULATORS=false
FIREBASE_EMULATOR_HOST=localhost

# Firebase Project Configuration (from Firebase Console -> Project Settings; never commit real keys)
FIREBASE_PROJECT_ID=crimemaps-515702
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here
